# Copy to functions/.env (gitignored) and fill in.
#
# Numeric GA4 property id used by `analyticsReport` for the admin analytics
# dashboard — Google Analytics → Admin → Property settings (e.g. 123456789).
# This is NOT the "G-XXXX" measurement id. See README → "Analytics dashboard
# setup" for the full one-time setup (enable the Data API + grant the function
# service account Viewer on the property).
GA4_PROPERTY_ID=
