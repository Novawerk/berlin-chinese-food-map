{
  "name": "berlinfoodmap-functions",
  "description": "Cloud Functions for Berlin Chinese Food Map — view-count aggregation and admin helpers.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill:view-counts": "tsx src/backfill-view-counts.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
